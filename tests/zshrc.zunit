#!/usr/bin/env zunit

# --- inference-server model discovery -------------------------------------------
#
# ~/.config/zsh/scripts/llm.sh caches the server's model id and exports
# LLAMA_DEFAULT_MODEL, MAKI_MODEL and STRATA_BASE_URL. LLM_CACHE_DIR points
# the cache at a scratch dir so the tests never touch the real one, and curl is
# replaced with a function that echoes a fixture response.
#
# MAKI_MODEL carries a provider slug because maki -m takes a full
# provider/model-id spec.

@test 'llm.sh reads the model id from an OpenAI-shaped response' {
  local dir
  dir=$(mktemp -d)
  run env LLM_CACHE_DIR="$dir" LLM_OPENAI_API_HOST="http://127.0.0.1:8000" zsh -c '
    curl() { print "{\"object\":\"list\",\"data\":[{\"id\":\"qwen3.8-flash-next-q2_0\"}]}"; }
    source /app/.config/zsh/scripts/llm.sh
    print "llama=$LLAMA_DEFAULT_MODEL maki=$MAKI_MODEL"
  '
  assert "$output" same_as "llama=qwen3.8-flash-next-q2_0 maki=strata/qwen3.8-flash-next-q2_0"
  cd / && rm -rf "$dir"
}

@test 'llm.sh falls back to the Ollama-shaped response' {
  local dir
  dir=$(mktemp -d)
  run env LLM_CACHE_DIR="$dir" LLM_OPENAI_API_HOST="http://127.0.0.1:8000" zsh -c '
    curl() { print "{\"models\":[{\"name\":\"unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL\"}]}"; }
    source /app/.config/zsh/scripts/llm.sh
    print "$LLAMA_DEFAULT_MODEL $MAKI_MODEL"
  '
  assert "$output" same_as "unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL strata/unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL"
  cd / && rm -rf "$dir"
}

@test 'llm.sh takes the maki provider slug from MAKI_PROVIDER' {
  local dir
  dir=$(mktemp -d)
  run env LLM_CACHE_DIR="$dir" LLM_OPENAI_API_HOST="http://127.0.0.1:8000" MAKI_PROVIDER=ollama zsh -c '
    curl() { print "{\"data\":[{\"id\":\"qwen3.8-flash-next-q2_0\"}]}"; }
    source /app/.config/zsh/scripts/llm.sh
    print "$MAKI_MODEL"
  '
  assert "$output" same_as "ollama/qwen3.8-flash-next-q2_0"
  cd / && rm -rf "$dir"
}

# maki appends /chat/completions but not /v1, and reads STRATA_BASE_URL ahead
# of providers.toml, so the exported value has to carry the /v1 suffix.
@test 'llm.sh exports STRATA_BASE_URL with the /v1 suffix' {
  local dir
  dir=$(mktemp -d)
  run env LLM_CACHE_DIR="$dir" LLM_OPENAI_API_HOST="http://127.0.0.1:8000" zsh -c '
    curl() { print "{\"data\":[{\"id\":\"qwen3.8-flash-next-q2_0\"}]}"; }
    source /app/.config/zsh/scripts/llm.sh
    print "$STRATA_BASE_URL"
  '
  assert "$output" same_as "http://127.0.0.1:8000/v1"
  cd / && rm -rf "$dir"
}

@test 'llm.sh derives STRATA_BASE_URL from LLM_OPENAI_API_HOST' {
  local dir
  dir=$(mktemp -d)
  run env LLM_CACHE_DIR="$dir" LLM_OPENAI_API_HOST="http://127.0.0.1:8000" zsh -c '
    curl() { print "{\"data\":[{\"id\":\"qwen3.8-flash-next-q2_0\"}]}"; }
    source /app/.config/zsh/scripts/llm.sh
    print "$STRATA_BASE_URL"
  '
  assert "$output" same_as "http://127.0.0.1:8000/v1"
  cd / && rm -rf "$dir"
}

@test 'llm.sh leaves STRATA_BASE_URL unset without a server' {
  local dir
  dir=$(mktemp -d)
  run env LLM_CACHE_DIR="$dir" zsh -c '
    curl() { print "{}"; }
    source /app/.config/zsh/scripts/llm.sh
    print "${STRATA_BASE_URL-UNSET}"
  '
  assert "$output" same_as "UNSET"
  cd / && rm -rf "$dir"
}

@test 'llm.sh builds /v1/models from LLM_OPENAI_API_HOST' {
  local dir
  dir=$(mktemp -d)
  # _llm_fetch captures curl's stdout as the model id, so the stub records the url
  # in a file and hands jq a payload it accepts.
  run env LLM_CACHE_DIR="$dir" LLM_URL_LOG="$dir/url" LLM_OPENAI_API_HOST="http://127.0.0.1:8000" zsh -c '
    curl() { print "$4" > "$LLM_URL_LOG"; print "{\"data\":[{\"id\":\"m\"}]}"; }
    source /app/.config/zsh/scripts/llm.sh
  '
  assert "$(cat "$dir/url") $(cat "$dir/model")" same_as "http://127.0.0.1:8000/v1/models m"
  cd / && rm -rf "$dir"
}

@test 'llm-refresh reports failure and keeps the previous model' {
  local dir
  dir=$(mktemp -d)
  run env LLM_CACHE_DIR="$dir" LLM_OPENAI_API_HOST="http://127.0.0.1:8000" zsh -c '
    curl() { print "{\"error\":\"unavailable\"}"; }
    source /app/.config/zsh/scripts/llm.sh
    llm-refresh
    print "rc=$? llama=$LLAMA_DEFAULT_MODEL cache=$(cat "$LLM_CACHE_DIR/model" 2>/dev/null)"
  '
  assert "$output" same_as "rc=1 llama= cache="
  cd / && rm -rf "$dir"
}

@test 'ZSH_THEME is set to gallifrey' {
  run zsh -c 'source ~/.zshrc 2>/dev/null; echo $ZSH_THEME'
  assert "$output" same_as "gallifrey"
}

@test 'DISABLE_AUTO_UPDATE is set for compinit caching' {
  run grep -q '^DISABLE_AUTO_UPDATE=true' ~/.zshrc
  assert $? equals 0
}

@test 'fast-syntax-highlighting is in plugins list' {
  run grep -q '^\s*fast-syntax-highlighting' ~/.zshrc
  assert $? equals 0
}

@test 'zsh-syntax-highlighting is NOT in the active plugins list' {
  run sed -n '/^plugins=/,/^)/p' ~/.zshrc | grep -v '^ *#' | grep 'zsh-syntax-highlighting' || true
  assert "$output" is_empty
}

@test 'PATH contains expected local and snap directories' {
  run zsh -c 'source ~/.zshrc 2>/dev/null; echo $PATH'
  assert "$HOME/.local/bin" is_substring_of "$output"
  assert "/snap/bin" is_substring_of "$output"
}

@test 'scripts loaded via glob, not $(ls ...)' {
  run grep '$(ls.*zsh/scripts' ~/.zshrc || true
  assert "$output" is_empty
}

@test 'no duplicate compinit call in .zshrc' {
  run grep -c 'compinit' ~/.zshrc || true
  assert "$output" same_as "0"
}

@test 'podman fallback alias is defined' {
  run grep -q 'alias docker=podman' ~/.zshrc
  assert $? equals 0
}

@test 'vi-mode is in plugins list' {
  run sed -n '/^plugins=/,/^)/p' ~/.zshrc | grep -v '^ *#' | grep 'vi-mode' || true
  assert "$output" is_empty --not
}

@test 'history options are set' {
  run grep -q '^setopt noincappendhistory' ~/.zshrc && grep -q '^setopt nosharehistory' ~/.zshrc
  assert $? equals 0
}

@test 'VI_MODE_SET_CURSOR is true' {
  run grep -q '^export VI_MODE_SET_CURSOR=true' ~/.zshrc
  assert $? equals 0
}

@test 'GOPATH is appended to PATH when Go is available' {
  run zsh -c 'source ~/.zshrc 2>/dev/null; echo $PATH'
  assert "$(go env GOPATH)/bin" is_substring_of "$output"
}

# --- gpoh fork guard ------------------------------------------------------
#
# gpoh checks the origin push URL against a list of allowed fork owners
# ($USER, $GH_USERNAME, $GH_ORGS). The tests use a local file:// remote so
# the push succeeds without ssh. The guard only inspects the URL string, so
# the scheme does not matter.

@test 'gpoh blocks push to a remote that matches no allowed owner' {
  local dir
  dir=$(mktemp -d)
  cd "$dir"
  git init -q
  git config user.email test@test
  git config user.name test
  git commit -q --allow-empty -m x
  git remote add origin "file:///tmp/gpoh-remote-$$.git"
  git remote set-url --push origin "file:///nonexistent-stranger.git"

  run env USER=kran zsh -c 'source /app/.config/zsh/scripts/git.sh; gpoh'
  assert $state equals 1
  assert "$output" contains "does NOT look like your fork"
  cd / && rm -rf "$dir"
}

@test 'gpoh allows push when remote matches $USER' {
  local dir remote
  dir=$(mktemp -d)
  remote="$dir/kran-remote.git"
  git init -q --bare "$remote"
  cd "$dir"
  git init -q work
  cd work
  git config user.email test@test
  git config user.name test
  git commit -q --allow-empty -m x
  git remote add origin "$remote"
  git remote set-url --push origin "file://$remote"

  local out
  out=$(USER=kran zsh -c "source /app/.config/zsh/scripts/git.sh; gpoh" 2>&1)
  assert "$out" does_not_contain "does NOT look like your fork"
  cd / && rm -rf "$dir"
}

@test 'gpoh allows push when remote matches $GH_USERNAME' {
  local dir remote
  dir=$(mktemp -d)
  remote="$dir/otherguy-remote.git"
  git init -q --bare "$remote"
  cd "$dir"
  git init -q work
  cd work
  git config user.email test@test
  git config user.name test
  git commit -q --allow-empty -m x
  git remote add origin "$remote"
  git remote set-url --push origin "file://$remote"

  local out
  out=$(USER=kran GH_USERNAME=otherguy zsh -c "source /app/.config/zsh/scripts/git.sh; gpoh" 2>&1)
  assert "$out" does_not_contain "does NOT look like your fork"
  cd / && rm -rf "$dir"
}

@test 'gpoh blocks push when $GH_USERNAME does not match the remote' {
  local dir
  dir=$(mktemp -d)
  cd "$dir"
  git init -q
  git config user.email test@test
  git config user.name test
  git commit -q --allow-empty -m x
  git remote add origin "file:///nonexistent.git"
  git remote set-url --push origin "file:///nonexistent.git"

  run env USER=kran GH_USERNAME=otherguy zsh -c 'source /app/.config/zsh/scripts/git.sh; gpoh'
  assert $state equals 1
  assert "$output" contains "does NOT look like your fork"
  cd / && rm -rf "$dir"
}

@test 'gpoh allows push when remote matches one of $GH_ORGS' {
  local dir remote
  dir=$(mktemp -d)
  remote="$dir/acme-org-remote.git"
  git init -q --bare "$remote"
  cd "$dir"
  git init -q work
  cd work
  git config user.email test@test
  git config user.name test
  git commit -q --allow-empty -m x
  git remote add origin "$remote"
  git remote set-url --push origin "file://$remote"

  local out
  out=$(USER=kran GH_ORGS=acme-org,mycorp zsh -c "source /app/.config/zsh/scripts/git.sh; gpoh" 2>&1)
  assert "$out" does_not_contain "does NOT look like your fork"
  cd / && rm -rf "$dir"
}

@test 'gpoh blocks push when $GH_ORGS contains no match for the remote' {
  local dir
  dir=$(mktemp -d)
  cd "$dir"
  git init -q
  git config user.email test@test
  git config user.name test
  git commit -q --allow-empty -m x
  git remote add origin "file:///nonexistent.git"
  git remote set-url --push origin "file:///nonexistent.git"

  run env USER=kran GH_ORGS=acme-org,mycorp zsh -c 'source /app/.config/zsh/scripts/git.sh; gpoh'
  assert $state equals 1
  assert "$output" contains "does NOT look like your fork"
  cd / && rm -rf "$dir"
}
